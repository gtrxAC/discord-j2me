    // This feature more specifically uses more network bandwidth, RAM, and storage, and also requires the gateway,
    // but this string is kept relatively short so the login screen is not too cluttered.
    "Для сінхранізацыі з афіцыйнымі кліентамі індыкатараў непрачытаных паведамленняў патрабуецца больш памяці.",

    // Label for the check box for toggling read state synchronization feature.
    "Сінхранізаваць непрачытаныя",
    
    // Softkey command labels for checking the status of HTTP-based QR login after the QR code has been scanned. If the check is successful, the token is received and the login is complete.
    // This can also be translated as e.g. "Continue".
    "Праверыць",
    "Праверыць",

    // Error message shown when the proxy server has not sent an authentication ID which is required for HTTP-based QR login.
    "Сеанс уваходу не атрыманы",

    // Help text shown in the QR login screen when using HTTP-based QR login.
    // "Check" should be pressed after the QR code is scanned on the Discord app on Android/iOS and the login is authorized by selecting the "Log in" button in the safety warning.
    "Націсніце «Праверыць» пасля таго, як вы адсканавалі і пацвердзілі ўваход на іншым тэлефоне.",

    // Error messages shown when opening a notification and the server, server channel, or DM conversation was not found in the loaded server/DM lists.
    "Сервер не знойдзены. ",
    "Канал не знойдзены",
    "Размова не знойдзена",

    // Help text shown after the "Server not found" error.
    "Калі вы далучыліся да гэтага сервера нядаўна, магчыма, вам трэба пачакаць некалькі дзён, каб спіс сервераў абнавіўся.",

    // Error messages shown during password login.
    "Няправільны адрас эл. пошты ці пароль",
    "Шматфактарная праверка сапраўднасці не ўключаная для гэтага ўліковага запісу.",
    "Шматфактарная праверка сапраўднасці праз праграму праверкі сапраўднасці (Authenticator) не ўключаная для гэтага ўліковага запісу.",

    // Header of error messages shown during password login.
    "Увайсці не ўдалося: ",

    // Header of the response sent by the server (for debugging purposes) during password login.
    "\nАдказ:\n",

    // Softkey labels used for starting password login. Shown in the login screen. The long variant of the softkey label is shown as the button text.
    "Пароль",
    "Уваход па паролі",

    // Warning shown when starting password login but Direct connection isn't enabled.
    "Для ўваходу па паролі патрабуецца непасрэднае злучэнне. Уключыць непасрэднае злучэнне і працягнуць?",

    // Error message shown when a server error response contains a CAPTCHA request. Tips for circumventing the CAPTCHA are shown below.
    "Атрымана капча. ",
    "Паспрабуйце зрабіць наступнае:",
    
    // Tips for circumventing the CAPTCHA:

    // (shown when the current build of the app doesn't support proxyless)
    "Усталюйце зборку праграмы, якая падтрымлівае непасрэднае злучэнне",
    // (shown when proxyless disabled and not in password login screen)
    "Уключыце наладу «Непасрэднае злучэнне»",
    // (shown when in password login screen)
    "Уключыце шматфактарную праверку сапраўднасці (праграма Authenticator) ва ўліковым запісе",
    "Увайдзіце ў афіцыйны кліент на іншай прыладзе з такім жа IP-адрасам (такі ж Wi-Fi ці SIM)",
    // (shown when not proxyless)
    "Паспрабуйце выкарыстаць іншы або свой проксі-сервер",
    // (shown always)
    "Паспрабуйце ўвайсці ў іншы ўліковы запіс",

    // Header text shown in the password login screen.
    "Каб увайсці па паролі, ва ўліковым запісе мусіць быць уключаная шматфактарная праверка сапраўднасці (праграма Authenticator).",

    // Text field labels shown in the password login screen.
    "Адрас эл. пошты",
    "Пароль",
    "Код для праверкі сапраўднасці",

    // Status messages showing the progress of password login.
    "Адпраўка запыту на ўваход…",
    "Адпраўка кода для праверкі сапраўднасці…",

    // Request for the 2-factor authentication (TOTP) code.
    "Увядзіце 6-значны код з праграмы праверкі сапраўднасці (напр. Google Authenticator).",

    // Softkey labels for the button used to continue password login after the authentication code was entered.
    "Працягнуць",
    "Працягнуць",

    // Error messages shown when trying to start password login without an email or password specified.
    "Увядзіце сапраўдны адрас эл. пошты",
    "Увядзіце пароль",

    // Another tip for circumventing the login CAPTCHA.
    // (shown when in password login screen)
    "Калі вашая прылада падтрымлівае Wi-Fi, падлучыцеся да такой жа сеткі Wi-Fi, да якой вы звычайна падлучаныя, калі карыстаецеся Discord",

    // Error message shown when the authentication code is in an invalid format.
    "Увядзіце сапраўдны код для праверкі сапраўднасці ў фармаце «123456»",

    // Progress message shown in the password login screen during the beginning, right after entering the password and email.
    "Пачынаецца працэс уваходу…",

    // Text shown before the latest update's changelog in the update dialog screen.
    "\n\nШто новага?\n",

    // Suffixes of attachment indicators in notification previews.
    // For example a notification could say
    //   User sent you a direct message: "Check this out (2 images) (1 file)"
    // "Images" are for any file types that are previewable as images (which also includes videos), "files" are for any other type of file.
    " файл)",
    " файлы(-аў))",
    " медыяфайл)",
    " медыяфайлы(-аў))",

    // Title for connection selection screen.
    "Злучэнне",

    // Option in the connection selection screen to use the device's standard connectivity to go online.
    "Сотавая перадача даных/Wi-Fi",

    // Option in the connection selection screen to search for devices to use Bluetooth tethering via BlueWAP Server app.
    "Пошук праз Bluetooth",

    // Option in the connection selection screen to show an explanation of BT tethering.
    "Даведка",

    // Line shown in the connection screen when a device search ended with no results.
    "Прылады не знойдзены",

    // Text shown in a separate dialog screen when a device search ended with no results.
    "Прылады не знойдзены. Пераканайцеся, што бачнасць прылады-сервера ўключаная, потым паўтарыце спробу.",

    // Line shown in the connection screen when a device search ended with at least one result.
    "Пошук завершаны",

    // Title for connection help dialog.
    "Даведка",

    // Lines shown in the connection help screen (separate dialog). These are formatted using bullet points.
    "Націсніце «Пошук праз Bluetooth», каб спалучыць прыладу, на якой запушчаны сервер BlueWAP.",
    "Выкарыстоўвайце непасрэднае злучэнне, калі прылада-сервер падтрымлівае TLS 1.2 (напр. Android 5+).",
    "Атрымайце сервер BlueWAP: github.com/gtrxAC/BlueWAP",

    // Lines shown in the connection screen when searching for devices or when connecting to a found device.
    "Пошук…",
    "Злучэнне…"
]
